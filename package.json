{
  "name": "zenstack-filter",
  "version": "0.1.0",
  "description": "Headless, type-safe filter system for ZenStack 3 — schema-driven FilterDefs, where-builder, persisted filters per scope.",
  "keywords": [
    "zenstack",
    "prisma",
    "filter",
    "where",
    "typescript",
    "react",
    "headless",
    "plugin",
    "codegen"
  ],
  "author": "Cedrik Meis <cedrik.meis@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klyecony/zenstack-filter.git"
  },
  "homepage": "https://github.com/klyecony/zenstack-filter#readme",
  "bugs": {
    "url": "https://github.com/klyecony/zenstack-filter/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/createFilterSystem.js",
  "module": "./dist/createFilterSystem.js",
  "types": "./dist/createFilterSystem.d.ts",
  "exports": {
    ".": {
      "types": "./dist/createFilterSystem.d.ts",
      "import": "./dist/createFilterSystem.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./operators": {
      "types": "./dist/operators.d.ts",
      "import": "./dist/operators.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./useFilter": {
      "types": "./dist/useFilter.d.ts",
      "import": "./dist/useFilter.js"
    },
    "./useFilterViews": {
      "types": "./dist/useFilterViews.d.ts",
      "import": "./dist/useFilterViews.js"
    },
    "./useFilterOptions": {
      "types": "./dist/useFilterOptions.d.ts",
      "import": "./dist/useFilterOptions.js"
    },
    "./infiniteSource": {
      "types": "./dist/infiniteSource.d.ts",
      "import": "./dist/infiniteSource.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check:types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@zenstackhq/language": "^3",
    "@zenstackhq/orm": "^3",
    "@zenstackhq/schema": "^3",
    "@zenstackhq/sdk": "^3",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@zenstackhq/language": {
      "optional": true
    },
    "@zenstackhq/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18 || ^19",
    "@zenstackhq/language": "^3",
    "@zenstackhq/orm": "^3",
    "@zenstackhq/schema": "^3",
    "@zenstackhq/sdk": "^3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
